{
  "name": "pi-jev-score",
  "version": "0.1.1",
  "description": "Pi extension that uses TypeSafe JEV to score final AI responses",
  "author": "marszhong",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marszhongx/pi-jev-score.git"
  },
  "homepage": "https://github.com/marszhongx/pi-jev-score#readme",
  "bugs": {
    "url": "https://github.com/marszhongx/pi-jev-score/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test test/config.test.ts test/scoring.test.ts test/extension.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "jev",
    "evaluation",
    "scoring"
  ],
  "files": [
    "jev-score.ts",
    "config.ts",
    "scoring.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./jev-score.ts"
    ]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
