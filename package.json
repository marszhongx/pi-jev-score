{
  "name": "pi-jev-score",
  "version": "0.1.0",
  "description": "Pi extension that uses TypeSafe JEV to score final AI responses",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test test/scoring.test.ts test/extension.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "jev",
    "evaluation",
    "scoring"
  ],
  "files": [
    "jev-score.ts",
    "scoring.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./jev-score.ts"
    ]
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
